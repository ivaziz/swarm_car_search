    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="rear_caster">
    <material>Gazebo/Grey</material>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <!-- Differential Drive Controller Plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="differential_drive_controller">
      <ros>
        <namespace>robot_1</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.5</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>robot_1/odom</odometry_frame>
      <robot_base_frame>robot_1/base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
  <!-- 2D LiDAR Sensor Plugin -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="robot_1_lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="robot_1_laser">
        <ros>
          <namespace>robot_1</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>robot_1/lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- RGB Camera Sensor Plugin -->
  <gazebo reference="camera_link">
    <material>Gazebo/Red</material>
    <sensor name="robot_1_camera" type="camera">
      <update_rate>15.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.5707963</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>25.0</far>
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="robot_1_camera_controller">
        <ros>
          <namespace>robot_1</namespace>
          <remapping>~/image_raw:=camera/image_raw</remapping>
          <remapping>~/camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>robot_1/camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- IMU Sensor Plugin -->
  <gazebo reference="imu_link">
    <sensor name="robot_1_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="robot_1_imu_plugin">
        <ros>
          <namespace>robot_1</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>robot_1/imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
